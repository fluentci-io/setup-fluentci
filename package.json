{
  "name": "setup-fluentci",
  "version": "1.0.0",
  "description": "Setup FluentCI on GitHub Actions.",
  "main": "dist/action.cjs",
  "scripts": {
    "format": "prettier --write src",
    "build": "tsc --noEmit && esbuild src/action.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/action.cjs",
    "start": "ts-node-esm src/action.ts",
    "start:dist": "node dist/action.cjs",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluentci-io/setup-fluentci.git"
  },
  "keywords": [
    "fluentci",
    "ci",
    "wasm"
  ],
  "author": "Tsiry Sandratraina <tsiry.sndr@fluentci.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fluentci-io/setup-fluentci/issues"
  },
  "homepage": "https://github.com/fluentci-io/setup-fluentci#readme",
  "type": "module",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "^1.1.1",
    "shell-quote": "^1.8.3"
  },
  "devDependencies": {
    "esbuild": "^0.17.12",
    "prettier": "^2.8.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.2",
    "@types/shell-quote": "^1.7.5"
  }
}
